# AgriMitra backend config — copy to .env and fill in
PORT=3000

# Upstream agricultural market-price API (leave empty until you have one).
# Example: MARKET_API_URL=https://api.example.com/mandi-prices
MARKET_API_URL=

# Optional bearer key for the upstream API (never expose to the frontend)
MARKET_API_KEY=

# Upstream weather API (leave empty until you have one).
# Example: WEATHER_API_URL=https://api.example.com/agri-weather
WEATHER_API_URL=

# Optional bearer key for the upstream weather API
WEATHER_API_KEY=
